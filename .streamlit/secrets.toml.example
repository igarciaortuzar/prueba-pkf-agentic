# Ejemplo de configuración de secrets para Streamlit (ver ADR-003).
#
# Copia este archivo a `.streamlit/secrets.toml` y completa los valores
# reales. `.streamlit/secrets.toml` NO se versiona (ver .gitignore) — en
# Streamlit Community Cloud estos mismos valores se configuran desde el
# panel de "Secrets" de la app, no subiendo este archivo.
#
# En desarrollo local / tests, si no defines TURSO_DATABASE_URL, la app cae
# automáticamente a un archivo libSQL local (ver app/db.py), así que no es
# obligatorio completar este archivo solo para desarrollar.

# URL de conexión a la base de datos Turso (producción).
# Formato remoto: "libsql://<nombre-db>-<org>.turso.io"
TURSO_DATABASE_URL = "libsql://mi-base-datos.turso.io"

# Token de autenticación de Turso (generado con `turso db tokens create`).
TURSO_AUTH_TOKEN = "reemplaza-con-el-token-real"

# Contraseña compartida para el acceso de las OTECs (gate de app.py).
# Pendiente de resolver (ver ADR-003, "Riesgos vigilados"): si es única y
# global o una por OTEC, y quién/cómo la rota.
APP_PASSWORD = "reemplaza-con-una-contraseña-real"
